<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
         <record id="view_stock_picking_aval_qty" model="ir.ui.view">
            <field name="name">stock.picking.aval.qty</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                   <xpath expr = "//field[@name = 'move_ids_without_package']/tree/field[@name = 'product_uom']"  position="after">
                         <field name="aval_qty"  force_save="1" optional="hide"  readonly="1"/>
                  </xpath>
            </field>
        </record>
    </data>
</odoo>