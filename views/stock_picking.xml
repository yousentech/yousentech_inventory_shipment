<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_stock_picking_location_readonly" model="ir.ui.view">
            <field name="name">stock.picking.location.dest.domain</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name = 'picking_type_id']" position="after">
                    <field name="prevent_update_source_des_location" invisible="1"/>
                    <!-- <field name="location_domain" invisible="1"/> -->
                </xpath>
                <xpath expr="//field[@name = 'location_dest_id']" position="attributes">
                    <attribute name="readonly">prevent_update_source_des_location</attribute>
                </xpath>
                <!-- <xpath expr="//field[@name = 'location_dest_id']" position="attributes">
                    <attribute name="domain">location_domain</attribute>
                </xpath> -->
                
                 <xpath expr="//field[@name = 'location_id']" position="attributes">
                    <attribute name="readonly">prevent_update_source_des_location</attribute>
                </xpath>


            </field>
        </record>
    </data>
</odoo>